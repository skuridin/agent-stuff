#!/bin/sh
# Usage: pr-threads [pr-number|url] [--all]
# Prints review threads (unresolved only by default) and non-empty review bodies.
set -eu

pr=""
all=false
for arg in "$@"; do
  case "$arg" in
    --all) all=true ;;
    *) pr="$arg" ;;
  esac
done

number=$(gh pr view $pr --json number --jq .number)
repo=$(gh repo view --json owner,name --jq '.owner.login + " " + .name')
owner=${repo% *}
name=${repo#* }

# ponytail: first 100 threads / 50 comments per thread, paginate if a PR ever exceeds that
gh api graphql -F owner="$owner" -F name="$name" -F number="$number" -f query='
query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      title url headRefName
      reviews(first: 100) { nodes { author { login } state body submittedAt } }
      reviewThreads(first: 100) {
        nodes {
          id isResolved isOutdated path line originalLine
          comments(first: 50) { nodes { databaseId author { login } body } }
        }
      }
    }
  }
}' | jq -r --argjson all "$all" '
  .data.repository.pullRequest as $pr
  | "PR #\($pr.url | split("/") | last) \($pr.title)\nbranch: \($pr.headRefName)\n",
    ($pr.reviews.nodes[] | select(.body != "")
      | "== review by \(.author.login) (\(.state))\n\(.body)\n"),
    ($pr.reviewThreads.nodes[] | select($all or (.isResolved | not))
      | "== thread \(.id) reply-to \(.comments.nodes[0].databaseId)\n\(.path):\(.line // .originalLine)"
        + (if .isResolved then " [resolved]" else "" end)
        + (if .isOutdated then " [outdated]" else "" end),
        (.comments.nodes[] | "- \(.author.login): \(.body)"),
        "")
'
